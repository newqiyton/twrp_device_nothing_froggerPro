service vendor.qti.vibrator /vendor/bin/hw/android.hardware.vibrator.service.nothing-rt_ics
    class hal
    user root
    group root input
    setenv RICHTAP_DEVICE_PATH  /dev/aw86927_haptic
    setenv ENV_RICHTAP_CONFIG_PATH /vendor/odm/etc/aac_richtap.config
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/system/lib64:/sbin
    disabled
    seclabel u:r:hal_vibrator_default:s0

on property:persist.sys.sfdc=*
        setprop persist.vendor.sfdc ${persist.sys.sfdc}
        
on property:persist.sys.sfdc.ntc=*
    setprop persist.vendor.sfdc.ntc ${persist.sys.sfdc.ntc}
    
